{
  "name": "@eops/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start:dev": "nest build && node ../../scripts/sync-server-workspace-dist.mjs && concurrently -k -n compiler,server,exports \"nest build --watch\" \"node --watch dist/apps/api/src/main.js\" \"node ../../scripts/sync-server-workspace-dist.mjs --watch\"",
    "start:prod": "node dist/apps/api/src/main.js",
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src ../../plugins/*/*/src/server ../../packages/database/src"
  },
  "dependencies": {
