model Election {
  id                     String                  @id @default(cuid())
  name                   String
  description            String?
  year                   Int
  type                   ElectionType
  status                 ElectionStatus          @default(PLANNING)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  rounds                 ElectionRound[]
  zones                  ElectoralZone[]
  incidents              Incident[]
  simulations            Simulation[]
  distributionRoutes     DistributionRoute[]
  transmissionPoints     TransmissionPoint[]
  fieldTeams             FieldTeam[]
  fieldAllocations       FieldAllocation[]
  communications         Communication[]
  evidences              Evidence[]
  risks                  Risk[]
  preparationChecklists  PreparationChecklist[]
  tasks                  Task[]
  taskMilestones         TaskMilestone[]
  resourceRequests       ResourceRequest[]
  commandCenterSnapshots CommandCenterSnapshot[]

  @@index([year, status])
}

model ElectionRound {
  id          String      @id @default(cuid())
  electionId  String
  roundNumber Int
  date        DateTime
  status      RoundStatus @default(SCHEDULED)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  election    Election    @relation(fields: [electionId], references: [id], onDelete: Cascade)

  @@unique([electionId, roundNumber])
  @@index([date, status])
}

model ElectoralZone {
  id                     String                  @id @default(cuid())
  electionId             String
  number                 Int
  name                   String
  municipality           String
  state                  String                  @db.Char(2)
  status                 ResourceStatus          @default(ACTIVE)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  election               Election                @relation(fields: [electionId], references: [id], onDelete: Cascade)
  pollingPlaces          PollingPlace[]
  incidents              Incident[]
  assets                 Asset[]
  assetMovementsFrom     AssetMovement[]         @relation("AssetMovementFromZone")
  assetMovementsTo       AssetMovement[]         @relation("AssetMovementToZone")
  assetAssignments       AssetAssignment[]
  distributionRoutes     DistributionRoute[]
  transmissionPoints     TransmissionPoint[]
  fieldShifts            FieldShift[]
  fieldShiftTemplates    FieldShiftTemplate[]
  fieldAllocations       FieldAllocation[]
  fieldChecks            FieldCheckEvent[]
  communicationAudiences CommunicationAudience[]
  risks                  Risk[]
  preparationChecklists  PreparationChecklist[]
  tasks                  Task[]
  fieldDispatches        FieldDispatch[]
  resourceRequests       ResourceRequest[]
  commandCenterSnapshots CommandCenterSnapshot[]

  @@unique([electionId, number])
  @@index([municipality, state])
}

model PollingPlace {
  id                     String                  @id @default(cuid())
  electoralZoneId        String
  name                   String
  address                String
  district               String
  city                   String
  state                  String                  @db.Char(2)
  latitude               Decimal?                @db.Decimal(9, 6)
  longitude              Decimal?                @db.Decimal(9, 6)
  status                 ResourceStatus          @default(ACTIVE)
  monitoringStatus       MonitoringStatus        @default(NORMAL)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  electoralZone          ElectoralZone           @relation(fields: [electoralZoneId], references: [id], onDelete: Cascade)
  sections               PollingSection[]
  incidents              Incident[]
  assets                 Asset[]
  assetMovementsFrom     AssetMovement[]         @relation("AssetMovementFromPlace")
  assetMovementsTo       AssetMovement[]         @relation("AssetMovementToPlace")
  assetAssignments       AssetAssignment[]
  simulationEvents       SimulationEvent[]
  routeStops             RouteStop[]
  deliveries             Delivery[]
  transmissionPoints     TransmissionPoint[]
  fieldShifts            FieldShift[]
  fieldShiftTemplates    FieldShiftTemplate[]
  fieldAllocations       FieldAllocation[]
  fieldChecks            FieldCheckEvent[]
  communicationAudiences CommunicationAudience[]
  risks                  Risk[]
  preparationChecklists  PreparationChecklist[]
  tasks                  Task[]
  fieldDispatches        FieldDispatch[]
  resourceRequests       ResourceRequest[]

  @@index([city, state])
  @@index([electoralZoneId, monitoringStatus])
}

model PollingSection {
  id               String         @id @default(cuid())
  pollingPlaceId   String
  number           Int
  registeredVoters Int
  status           ResourceStatus @default(ACTIVE)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  pollingPlace     PollingPlace   @relation(fields: [pollingPlaceId], references: [id], onDelete: Cascade)

  @@unique([pollingPlaceId, number])
  @@index([status])
}

model IncidentCategory {
  id          String     @id @default(cuid())
  key         String     @unique
  name        String
  description String?
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  incidents   Incident[]

  @@index([active, name])
}

model Incident {
  id                         String                      @id @default(cuid())
  code                       String                      @unique
  title                      String
  description                String
  severity                   IncidentSeverity
  status                     IncidentStatus              @default(NEW)
  electionId                 String
  electoralZoneId            String?
  pollingPlaceId             String?
  categoryId                 String
  createdById                String?
  assignedToId               String?
  assignedToName             String?
  openedAt                   DateTime                    @default(now())
  resolvedAt                 DateTime?
  closedAt                   DateTime?
  slaDeadline                DateTime?
  acknowledgedAt             DateTime?
  acknowledgedById           String?
  escalationLevel            Int                         @default(0)
  escalatedAt                DateTime?
  escalatedById              String?
  escalationReason           String?
  isSimulated                Boolean                     @default(false)
  simulationId               String?
  assetId                    String?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  election                   Election                    @relation(fields: [electionId], references: [id], onDelete: Cascade)
  electoralZone              ElectoralZone?              @relation(fields: [electoralZoneId], references: [id], onDelete: SetNull)
  pollingPlace               PollingPlace?               @relation(fields: [pollingPlaceId], references: [id], onDelete: SetNull)
  category                   IncidentCategory            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  asset                      Asset?                      @relation(fields: [assetId], references: [id], onDelete: SetNull)
  simulation                 Simulation?                 @relation(fields: [simulationId], references: [id], onDelete: SetNull)
  events                     IncidentEvent[]
  assignments                IncidentAssignment[]
  simulationEvents           SimulationEvent[]
  fieldDispatches            FieldDispatch[]
  handoverReferences         ShiftHandoverIncident[]
  resourceRequests           ResourceRequest[]
  postmortems                Postmortem[]                @relation("PostmortemPrimaryIncident")
  postmortemRelatedIncidents PostmortemRelatedIncident[]

  @@index([electionId, status])
  @@index([electoralZoneId, status])
  @@index([pollingPlaceId, status])
  @@index([severity, status])
  @@index([slaDeadline])
  @@index([status, escalationLevel, slaDeadline])
  @@index([assetId])
  @@index([simulationId])
}

model IncidentEvent {
  id         String            @id @default(cuid())
  incidentId String
  type       IncidentEventType
  message    String
  actorId    String?
  metadata   Json?
  createdAt  DateTime          @default(now())
  incident   Incident          @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
}

model IncidentAssignment {
  id             String    @id @default(cuid())
  incidentId     String
  assignedToId   String?
  assignedToName String
  assignedById   String?
  reason         String?
  assignedAt     DateTime  @default(now())
  endedAt        DateTime?
  incident       Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, assignedAt])
  @@index([assignedToId])
}

model AssetType {
  id                   String                @id @default(cuid())
  key                  String                @unique
  name                 String
  description          String?
  active               Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  assets               Asset[]
  resourceRequestItems ResourceRequestItem[]

  @@index([active, name])
}

model Asset {
  id                          String                       @id @default(cuid())
  assetTag                    String                       @unique
  name                        String
  typeId                      String
  serialNumber                String?
  manufacturer                String?
  model                       String?
  status                      AssetStatus                  @default(AVAILABLE)
  condition                   AssetCondition               @default(GOOD)
  electoralZoneId             String?
  pollingPlaceId              String?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  type                        AssetType                    @relation(fields: [typeId], references: [id], onDelete: Restrict)
  electoralZone               ElectoralZone?               @relation(fields: [electoralZoneId], references: [id], onDelete: SetNull)
  pollingPlace                PollingPlace?                @relation(fields: [pollingPlaceId], references: [id], onDelete: SetNull)
  movements                   AssetMovement[]
  assignments                 AssetAssignment[]
  reservations                AssetReservation[]
  maintenances                AssetMaintenance[]
  incidents                   Incident[]
  simulationEvents            SimulationEvent[]
  deliveryItems               DeliveryItem[]
  handoverReferences          ShiftHandoverAsset[]
  resourceRequestFulfillments ResourceRequestFulfillment[]

  @@index([typeId, status])
  @@index([electoralZoneId, status])
  @@index([pollingPlaceId, status])
  @@index([condition])
}

model AssetMovement {
  id                 String         @id @default(cuid())
  assetId            String
  fromZoneId         String?
  fromPollingPlaceId String?
  toZoneId           String?
  toPollingPlaceId   String?
  originLabel        String
  destinationLabel   String
  responsibleId      String?
  responsibleName    String
  reason             String
  statusBefore       AssetStatus
  statusAfter        AssetStatus
  movedAt            DateTime       @default(now())
  createdAt          DateTime       @default(now())
  asset              Asset          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fromZone           ElectoralZone? @relation("AssetMovementFromZone", fields: [fromZoneId], references: [id], onDelete: SetNull)
  fromPollingPlace   PollingPlace?  @relation("AssetMovementFromPlace", fields: [fromPollingPlaceId], references: [id], onDelete: SetNull)
  toZone             ElectoralZone? @relation("AssetMovementToZone", fields: [toZoneId], references: [id], onDelete: SetNull)
  toPollingPlace     PollingPlace?  @relation("AssetMovementToPlace", fields: [toPollingPlaceId], references: [id], onDelete: SetNull)

  @@index([assetId, movedAt])
  @@index([toZoneId, movedAt])
  @@index([toPollingPlaceId, movedAt])
}

model AssetAssignment {
  id               String              @id @default(cuid())
  assetId          String
  kind             AssetAssignmentKind @default(ALLOCATION)
  electoralZoneId  String?
  pollingPlaceId   String?
  assignedToId     String?
  assignedToName   String?
  purpose          String?
  originLabel      String?
  destinationLabel String?
  expectedReturnAt DateTime?
  conditionOut     AssetCondition?
  conditionIn      AssetCondition?
  returnedAt       DateTime?
  returnedTo       String?
  receivedById     String?
  receivedByName   String?
  checkedOutById   String?
  checkedInById    String?
  checkoutNotes    String?
  returnNotes      String?
  problemDetected  Boolean             @default(false)
  assignedAt       DateTime            @default(now())
  endedAt          DateTime?
  asset            Asset               @relation(fields: [assetId], references: [id], onDelete: Cascade)
  electoralZone    ElectoralZone?      @relation(fields: [electoralZoneId], references: [id], onDelete: SetNull)
  pollingPlace     PollingPlace?       @relation(fields: [pollingPlaceId], references: [id], onDelete: SetNull)

  @@index([assetId, assignedAt])
  @@index([assetId, kind, endedAt])
  @@index([pollingPlaceId, endedAt])
  @@index([expectedReturnAt, endedAt])
}

model AssetReservation {
  id                          String                       @id @default(cuid())
  assetId                     String
  requesterId                 String?
  requesterName               String
  purpose                     String
  startsAt                    DateTime
  endsAt                      DateTime
  status                      AssetReservationStatus       @default(REQUESTED)
  notes                       String?
  createdById                 String?
  approvedById                String?
  approvedAt                  DateTime?
  fulfilledAt                 DateTime?
  cancelledAt                 DateTime?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  asset                       Asset                        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  resourceRequestFulfillments ResourceRequestFulfillment[]

  @@index([assetId, status])
  @@index([startsAt, endsAt])
  @@index([status, endsAt])
}

model AssetMaintenance {
  id            String                 @id @default(cuid())
  assetId       String
  type          AssetMaintenanceType
  status        AssetMaintenanceStatus @default(OPEN)
  description   String
  responsible   String
  cost          Decimal?               @db.Decimal(12, 2)
  result        String?
  notes         String?
  openedAt      DateTime               @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?
  openedById    String?
  completedById String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  asset         Asset                  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, status])
  @@index([status, openedAt])
}

model User {
  id                                   String                         @id @default(cuid())
  name                                 String
  email                                String                         @unique
  passwordHash                         String
  status                               UserStatus                     @default(ACTIVE)
  createdAt                            DateTime                       @default(now())
  updatedAt                            DateTime                       @updatedAt
  roles                                UserRole[]
  auditEvents                          AuditEvent[]
  notifications                        Notification[]
  notificationPreferences              NotificationPreference[]
  communicationAudiences               CommunicationAudience[]        @relation("CommunicationAudienceTarget")
  communicationRecipients              CommunicationRecipient[]       @relation("CommunicationRecipientUser")
  assignedPreparationChecklists        PreparationChecklist[]         @relation("PreparationChecklistAssignee")
  approvedPreparationChecklists        PreparationChecklist[]         @relation("PreparationChecklistApprover")
  assignedPreparationChecklistItems    PreparationChecklistItem[]     @relation("PreparationChecklistItemAssignee")
  recordedPreparationChecklistEvidence PreparationChecklistEvidence[]
  preparationChecklistHistory          PreparationChecklistHistory[]
  assignedTasks                        Task[]                         @relation("TaskAssignee")
  createdTasks                         Task[]                         @relation("TaskCreator")
  completedTaskChecklistItems          TaskChecklistItem[]            @relation("TaskChecklistItemDoneBy")
  taskSavedFilters                     TaskSavedFilter[]
  taskComments                         TaskComment[]
  taskHistory                          TaskHistory[]                  @relation("TaskHistoryActor")
  shiftHistory                         FieldShiftHistory[]            @relation("FieldShiftHistoryActor")
  shiftReplacements                    FieldShiftReplacement[]        @relation("FieldShiftReplacementActor")
  fieldMemberUnavailability            FieldMemberUnavailability[]    @relation("FieldMemberUnavailabilityActor")
  createdFieldDispatches               FieldDispatch[]                @relation("FieldDispatchCreator")
  fieldDispatchEvents                  FieldDispatchEvent[]           @relation("FieldDispatchEventActor")
  acknowledgedTransmissionAlerts       TransmissionAlert[]            @relation("TransmissionAlertAcknowledger")
  resolvedTransmissionAlerts           TransmissionAlert[]            @relation("TransmissionAlertResolver")
  sentShiftHandovers                   ShiftHandover[]                @relation("ShiftHandoverSender")
  receivedShiftHandovers               ShiftHandover[]                @relation("ShiftHandoverRecipient")
  confirmedShiftHandovers              ShiftHandover[]                @relation("ShiftHandoverConfirmer")
  cancelledShiftHandovers              ShiftHandover[]                @relation("ShiftHandoverCanceller")
  shiftHandoverHistory                 ShiftHandoverHistory[]         @relation("ShiftHandoverHistoryActor")
  commandCenterSavedViews              CommandCenterSavedView[]       @relation("CommandCenterSavedViewOwner")
  commandCenterSnapshots               CommandCenterSnapshot[]        @relation("CommandCenterSnapshotCreator")
  createdResourceRequests              ResourceRequest[]              @relation("ResourceRequestRequester")
  ownedResourceRequests                ResourceRequest[]              @relation("ResourceRequestOwner")
  resourceRequestFulfillments          ResourceRequestFulfillment[]   @relation("ResourceRequestFulfiller")
  resourceRequestHistory               ResourceRequestHistory[]       @relation("ResourceRequestHistoryActor")
  resourceRequestComments              ResourceRequestComment[]       @relation("ResourceRequestCommentAuthor")
  createdPostmortems                   Postmortem[]                   @relation("PostmortemCreator")
  ownedPostmortems                     Postmortem[]                   @relation("PostmortemOwner")
  publishedPostmortems                 Postmortem[]                   @relation("PostmortemPublisher")
  postmortemTimelineEntries            PostmortemTimelineEntry[]      @relation("PostmortemTimelineActor")
  ownedPostmortemActions               PostmortemActionItem[]         @relation("PostmortemActionOwner")
  createdPostmortemActions             PostmortemActionItem[]         @relation("PostmortemActionCreator")
  postmortemReviews                    PostmortemReview[]             @relation("PostmortemReviewAuthor")
  postmortemReviewerAssignments        PostmortemReviewer[]           @relation("PostmortemReviewerAssignee")

  @@index([status, name])
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String?
  system      Boolean          @default(false)
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model AuditEvent {
  id         String      @id @default(cuid())
  actorId    String?
  eventName  String?
  action     AuditAction
  entityType String
  entityId   String?
  oldData    Json?
  newData    Json?
  metadata   Json?
  createdAt  DateTime    @default(now())
  actor      User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([eventName, createdAt])
  @@index([entityType, entityId])
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  type       NotificationType @default(INFO)
  title      String
  message    String
  eventName  String?
  entityType String?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime         @default(now())
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([eventName, createdAt])
}

model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String
  eventName String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventName])
}

model SimulationScenario {
  id              String                    @id @default(cuid())
  name            String
  description     String?
  configuration   Json
  active          Boolean                   @default(true)
  seed            Int?
  durationSeconds Int?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  simulations     Simulation[]
  events          SimulationScenarioEvent[]

  @@index([active, name])
}

enum SimulationScenarioEventType {
  INCIDENT_CREATE
  TRANSMISSION_FAILURE
  TRANSMISSION_RECOVERY
  ASSET_FAILURE
  ASSET_RECOVERY
}

enum SimulationTargetType {
  NONE
  POLLING_PLACE
  ZONE
  ASSET
  TRANSMISSION
}

model SimulationScenarioEvent {
  id               String                      @id @default(cuid())
  scenarioId       String
  offsetSeconds    Int
  type             SimulationScenarioEventType
  severity         IncidentSeverity?
  targetType       SimulationTargetType        @default(NONE)
  targetId         String?
  probability      Int                         @default(100)
  payload          Json?
  createdAt        DateTime                    @default(now())
  scenario         SimulationScenario          @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  simulationEvents SimulationEvent[]

  @@unique([scenarioId, offsetSeconds, type])
  @@index([scenarioId, offsetSeconds])
}

model Simulation {
  id                String              @id @default(cuid())
  name              String
  electionId        String
  scenarioId        String?
  status            SimulationStatus    @default(DRAFT)
  speed             Int                 @default(1)
  probability       FailureProbability  @default(LOW)
  connectivity      Boolean             @default(true)
  equipment         Boolean             @default(true)
  transmission      Boolean             @default(true)
  logistics         Boolean             @default(true)
  applyToOperations Boolean             @default(false)
  elapsedSeconds    Int                 @default(0)
  seed              Int?
  score             Int?
  scoreBreakdown    Json?
  startedAt         DateTime?
  pausedAt          DateTime?
  endedAt           DateTime?
  createdById       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  election          Election            @relation(fields: [electionId], references: [id], onDelete: Cascade)
  scenario          SimulationScenario? @relation(fields: [scenarioId], references: [id], onDelete: SetNull)
  events            SimulationEvent[]
  incidents         Incident[]

  @@index([electionId, status])
  @@index([createdAt])
}

model SimulationEvent {
  id              String                   @id @default(cuid())
  simulationId    String
  eventType       String
  title           String
  description     String?
  offsetSeconds   Int
  payload         Json?
  result          String?
  severity        IncidentSeverity?
  incidentId      String?
  assetId         String?
  pollingPlaceId  String?
  scenarioEventId String?
  createdAt       DateTime                 @default(now())
  simulation      Simulation               @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  incident        Incident?                @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  asset           Asset?                   @relation(fields: [assetId], references: [id], onDelete: SetNull)
  pollingPlace    PollingPlace?            @relation(fields: [pollingPlaceId], references: [id], onDelete: SetNull)
  scenarioEvent   SimulationScenarioEvent? @relation(fields: [scenarioEventId], references: [id], onDelete: SetNull)

  @@unique([simulationId, scenarioEventId])
  @@index([simulationId, offsetSeconds])
  @@index([incidentId])
}

model Vehicle {
  id                          String                       @id @default(cuid())
  identification              String                       @unique
  plate                       String                       @unique
  model                       String
  capacity                    Int?
  status                      VehicleStatus                @default(AVAILABLE)
  driverName                  String?
  responsibleName             String?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  routes                      DistributionRoute[]
  resourceRequestItems        ResourceRequestItem[]
  resourceRequestFulfillments ResourceRequestFulfillment[]

  @@index([status])
}

model DistributionRoute {
  id                          String                       @id @default(cuid())
  code                        String                       @unique
  name                        String
  electionId                  String
  electoralZoneId             String
  description                 String?
  originName                  String
  originLatitude              Decimal?                     @db.Decimal(9, 6)
  originLongitude             Decimal?                     @db.Decimal(9, 6)
  destinationName             String
  destinationLatitude         Decimal?                     @db.Decimal(9, 6)
  destinationLongitude        Decimal?                     @db.Decimal(9, 6)
  plannedDeparture            DateTime
  plannedArrival              DateTime
  actualDeparture             DateTime?
  actualArrival               DateTime?
  responsibleName             String
  driverName                  String?
  vehicleId                   String?
  notes                       String?
  status                      RouteStatus                  @default(PLANNED)
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  election                    Election                     @relation(fields: [electionId], references: [id], onDelete: Cascade)
  electoralZone               ElectoralZone                @relation(fields: [electoralZoneId], references: [id], onDelete: Restrict)
  vehicle                     Vehicle?                     @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  stops                       RouteStop[]
  deliveries                  Delivery[]
  batches                     DeliveryBatch[]
  history                     RouteHistoryEvent[]
  exceptions                  RouteException[]
  resourceRequestFulfillments ResourceRequestFulfillment[]

  @@index([electionId, status])
  @@index([electoralZoneId, status])
  @@index([responsibleName])
  @@index([plannedDeparture])
}

model RouteStop {
  id             String            @id @default(cuid())
  routeId        String
  pollingPlaceId String?
  order          Int
  description    String
  latitude       Decimal?          @db.Decimal(9, 6)
  longitude      Decimal?          @db.Decimal(9, 6)
  eta            DateTime
  actualAt       DateTime?
  status         RouteStopStatus   @default(PENDING)
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  route          DistributionRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  pollingPlace   PollingPlace?     @relation(fields: [pollingPlaceId], references: [id], onDelete: SetNull)
  exceptions     RouteException[]

  @@unique([routeId, order])
  @@index([eta, status])
}

model DeliveryBatch {
  id          String            @id @default(cuid())
  routeId     String
  code        String            @unique
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  route       DistributionRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  deliveries  Delivery[]

  @@index([routeId])
}

model Delivery {
  id             String            @id @default(cuid())
  routeId        String
  batchId        String?
  pollingPlaceId String
  status         DeliveryStatus    @default(PENDING)
  receiverName   String?
  deliveredAt    DateTime?
  notes          String?
  proofUrl       String?
  failureReason  String?
  handledById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  route          DistributionRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  batch          DeliveryBatch?    @relation(fields: [batchId], references: [id], onDelete: SetNull)
  pollingPlace   PollingPlace      @relation(fields: [pollingPlaceId], references: [id], onDelete: Restrict)
  items          DeliveryItem[]
  exceptions     RouteException[]

  @@index([routeId, status])
  @@index([pollingPlaceId, status])
  @@index([batchId])
}

model DeliveryItem {
  id          String   @id @default(cuid())
  deliveryId  String
  assetId     String?
  description String
  quantity    Int      @default(1)
  lotCode     String?
  delivery    Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  asset       Asset?   @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([deliveryId])
  @@index([assetId])
}

model RouteHistoryEvent {
  id        String             @id @default(cuid())
  routeId   String
  type      LogisticsEventType
  message   String
  actorId   String?
  metadata  Json?
  createdAt DateTime           @default(now())
  route     DistributionRoute  @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([routeId, createdAt])
}

model RouteException {
  id           String               @id @default(cuid())
  routeId      String
  stopId       String?
  deliveryId   String?
  reason       RouteExceptionReason
  notes        String?
  actorId      String?
  occurredAt   DateTime             @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  resolution   String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  route        DistributionRoute    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stop         RouteStop?           @relation(fields: [stopId], references: [id], onDelete: SetNull)
  delivery     Delivery?            @relation(fields: [deliveryId], references: [id], onDelete: SetNull)

  @@index([routeId, createdAt])
  @@index([routeId, resolvedAt])
  @@index([stopId])
  @@index([deliveryId])
}

model TransmissionPoint {
  id                  String                      @id @default(cuid())
  electionId          String
  electoralZoneId     String
  pollingPlaceId      String
  identification      String                      @unique
  status              TransmissionStatus          @default(WAITING)
  connectivity        ConnectivityStatus          @default(UNKNOWN)
  lastActivity        DateTime?
  observations        String?
  latencyMs           Int?
  lastCheckedAt       DateTime?
  connectionMethod    String?
  priority            Int                         @default(3)
  queuedAt            DateTime?
  operationalDeadline DateTime?
  attemptCount        Int                         @default(0)
  lastError           String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  election            Election                    @relation(fields: [electionId], references: [id], onDelete: Cascade)
  electoralZone       ElectoralZone               @relation(fields: [electoralZoneId], references: [id], onDelete: Restrict)
  pollingPlace        PollingPlace                @relation(fields: [pollingPlaceId], references: [id], onDelete: Restrict)
  attempts            TransmissionAttempt[]
  timeline            TransmissionTimelineEvent[]
  alerts              TransmissionAlert[]

  @@index([electionId, status])
  @@index([electoralZoneId, status])
  @@index([pollingPlaceId])
  @@index([priority, queuedAt])
  @@index([connectivity])
}

model TransmissionAttempt {
  id         String                    @id @default(cuid())
  pointId    String
  number     Int
  startedAt  DateTime
  endedAt    DateTime
  result     TransmissionAttemptResult
  durationMs Int
  error      String?
  createdAt  DateTime                  @default(now())
  point      TransmissionPoint         @relation(fields: [pointId], references: [id], onDelete: Cascade)

  @@unique([pointId, number])
  @@index([pointId, startedAt])
}

model TransmissionTimelineEvent {
  id        String                @id @default(cuid())
  pointId   String
  type      TransmissionEventType
  message   String
  metadata  Json?
  createdAt DateTime              @default(now())
  point     TransmissionPoint     @relation(fields: [pointId], references: [id], onDelete: Cascade)

  @@index([pointId, createdAt])
}

model TransmissionAlert {
  id               String                  @id @default(cuid())
  pointId          String
  type             TransmissionAlertType
  status           TransmissionAlertStatus @default(OPEN)
  message          String
  notes            String?
  acknowledgedAt   DateTime?
  acknowledgedById String?
  resolvedAt       DateTime?
  resolvedById     String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  point            TransmissionPoint       @relation(fields: [pointId], references: [id], onDelete: Cascade)
  acknowledgedBy   User?                   @relation("TransmissionAlertAcknowledger", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  resolvedBy       User?                   @relation("TransmissionAlertResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([pointId, status])
  @@index([type, status])
  @@index([status, createdAt])
}

model FieldTeam {
  id                          String                       @id @default(cuid())
  name                        String
  code                        String                       @unique
  electionId                  String
  responsibleName             String
  status                      FieldTeamStatus              @default(ACTIVE)
  notes                       String?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  election                    Election                     @relation(fields: [electionId], references: [id], onDelete: Cascade)
  members                     FieldMember[]
  shifts                      FieldShift[]
  shiftTemplates              FieldShiftTemplate[]
  allocations                 FieldAllocation[]
  dispatches                  FieldDispatch[]
  communicationAudiences      CommunicationAudience[]
  resourceRequestItems        ResourceRequestItem[]
  resourceRequestFulfillments ResourceRequestFulfillment[]

  @@index([electionId, status])
  @@index([responsibleName])
}

model FieldRole {
  id                     String                  @id @default(cuid())
  key                    String                  @unique
  name                   String
  description            String?
  active                 Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  members                FieldMember[]
  communicationAudiences CommunicationAudience[]
  shiftAssignments       FieldShiftAssignment[]

  @@index([active, name])
}

model FieldSpecialty {
  id                   String                                   @id @default(cuid())
  key                  String                                   @unique
  name                 String
  description          String?
  active               Boolean                                  @default(true)
  createdAt            DateTime                                 @default(now())
  updatedAt            DateTime                                 @updatedAt
  members              FieldMemberSpecialty[]
  shiftRequirements    FieldShiftSpecialtyRequirement[]
  templateRequirements FieldShiftTemplateSpecialtyRequirement[]
  taskRequirements     TaskSpecialtyRequirement[]

  @@index([active, name])
}

model FieldMember {
  id                      String                      @id @default(cuid())
  teamId                  String
  roleId                  String
  name                    String
  phone                   String?
  email                   String?
  status                  MemberAvailability          @default(AVAILABLE)
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  team                    FieldTeam                   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  role                    FieldRole                   @relation(fields: [roleId], references: [id], onDelete: Restrict)
  specialties             FieldMemberSpecialty[]
  shifts                  FieldShift[]
  shiftAssignments        FieldShiftAssignment[]
  allocations             FieldAllocation[]
  checks                  FieldCheckEvent[]
  unavailability          FieldMemberUnavailability[]
  dispatches              FieldDispatch[]
  communicationRecipients CommunicationRecipient[]

  @@index([teamId, status])
  @@index([roleId])
  @@index([name])
}

model FieldMemberUnavailability {
  id        String      @id @default(cuid())
  memberId  String
  startsAt  DateTime
  endsAt    DateTime
  reason    String
  notes     String?     @db.Text
  actorId   String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  member    FieldMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  actor     User?       @relation("FieldMemberUnavailabilityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([memberId, startsAt, endsAt])
  @@index([actorId, createdAt])
}

model FieldMemberSpecialty {
  id          String         @id @default(cuid())
  memberId    String
  specialtyId String
  member      FieldMember    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  specialty   FieldSpecialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@unique([memberId, specialtyId])
  @@index([specialtyId])
}

model FieldShift {
  id                    String                           @id @default(cuid())
  teamId                String
  memberId              String?
  electoralZoneId       String?
  pollingPlaceId        String?
  name                  String?
  requiredOperators     Int                              @default(1)
  status                FieldShiftStatus                 @default(SCHEDULED)
  startsAt              DateTime
  endsAt                DateTime
  notes                 String?
  createdAt             DateTime                         @default(now())
  updatedAt             DateTime                         @updatedAt
  team                  FieldTeam                        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  member                FieldMember?                     @relation(fields: [memberId], references: [id], onDelete: SetNull)
  electoralZone         ElectoralZone?                   @relation(fields: [electoralZoneId], references: [id], onDelete: SetNull)
  pollingPlace          PollingPlace?                    @relation(fields: [pollingPlaceId], references: [id], onDelete: SetNull)
