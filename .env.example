DATABASE_URL="postgresql://eops:eops_dev@localhost:5432/election_ops?schema=public"
JWT_SECRET="replace-with-a-long-random-development-secret"
DEMO_ADMIN_PASSWORD="change-this-demo-password"
PORT=3001
VITE_API_URL="http://localhost:3001/api"

# Tolerância a cold start/instabilidade transitória do PostgreSQL/Neon.
DATABASE_CONNECT_RETRIES=8
DATABASE_CONNECT_RETRY_BASE_MS=1000

# Dimensionamento do pool do Prisma. O pool padrão é calculado por núcleos da
# máquina e pode exceder o limite de sessões de um pooler (por exemplo, 15 em
# modo session), fazendo consultas paralelas falharem com EMAXCONNSESSION.
# Ajuste apenas se o banco oferecer mais sessões.
DATABASE_CONNECTION_LIMIT=5
DATABASE_POOL_TIMEOUT_SECONDS=20

# Espera por conexão e duração máxima de transações interativas. Precisam
# acomodar a fila do pool limitado, senão a transação expira e a API responde 500.
DATABASE_TRANSACTION_MAX_WAIT_MS=10000
DATABASE_TRANSACTION_TIMEOUT_MS=15000

# Armazenamento de evidências (driver local em desenvolvimento)
EVIDENCE_STORAGE_DRIVER=local
EVIDENCE_STORAGE_ROOT=storage/evidence

# Navegador do Playwright. Em CI use `chromium`; localmente o padrão é `msedge`.
# PLAYWRIGHT_CHANNEL=chromium
