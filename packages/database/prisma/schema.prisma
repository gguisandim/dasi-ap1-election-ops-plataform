  replacements          FieldShiftReplacement[]
  history               FieldShiftHistory[]
  specialtyRequirements FieldShiftSpecialtyRequirement[]
  handovers             ShiftHandover[]

  @@index([startsAt, endsAt])
  @@index([teamId, startsAt])
  @@index([memberId, startsAt])
  @@index([status, startsAt])
  @@index([electoralZoneId, startsAt])
  @@index([pollingPlaceId, startsAt])
}

model ShiftHandover {
  id                 String                  @id @default(cuid())
  shiftId            String
  senderUserId       String
  recipientUserId    String
  summary            String                  @db.Text
  pendingNotes       String?                 @db.Text
  observations       String?                 @db.Text
  status             ShiftHandoverStatus     @default(DRAFT)
  submittedAt        DateTime?
  confirmedAt        DateTime?
  confirmedById      String?
  cancelledAt        DateTime?
  cancelledById      String?
  cancellationReason String?                 @db.Text
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  shift              FieldShift              @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  sender             User                    @relation("ShiftHandoverSender", fields: [senderUserId], references: [id], onDelete: Restrict)
  recipient          User                    @relation("ShiftHandoverRecipient", fields: [recipientUserId], references: [id], onDelete: Restrict)
  confirmedBy        User?                   @relation("ShiftHandoverConfirmer", fields: [confirmedById], references: [id], onDelete: SetNull)
  cancelledBy        User?                   @relation("ShiftHandoverCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)
  incidents          ShiftHandoverIncident[]
  tasks              ShiftHandoverTask[]
  assets             ShiftHandoverAsset[]
  history            ShiftHandoverHistory[]

  @@index([status, createdAt])
  @@index([recipientUserId, status])
  @@index([senderUserId, createdAt])
  @@index([shiftId, createdAt])
  @@index([submittedAt])
}

model ShiftHandoverIncident {
  handoverId String
  incidentId String
  createdAt  DateTime      @default(now())
  handover   ShiftHandover @relation(fields: [handoverId], references: [id], onDelete: Cascade)
