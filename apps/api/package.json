    "@eops/plugin-routes": "0.1.0",
    "@eops/plugin-shifts": "0.1.0",
    "@eops/plugin-tasks": "0.1.0",
    "@eops/plugin-transmission": "0.1.0",
    "@eops/security": "0.1.0",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/mapped-types": "12.0.0",
    "@nestjs/platform-express": "12.1.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
