{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "../..",
    "baseUrl": "./",
    "ignoreDeprecations": "6.0",
    "types": ["node"],
    "incremental": false,
    "skipLibCheck": true,
    "strict": true
  }
}
