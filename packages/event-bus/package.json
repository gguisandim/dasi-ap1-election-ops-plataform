{
  "name": "@eops/event-bus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "dependencies": {
    "@eops/shared": "0.1.0",
    "@nestjs/common": "12.1.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./src/contracts.ts",
      "require": "./dist/contracts.js",
      "default": "./dist/contracts.js"
    }
  }
}
