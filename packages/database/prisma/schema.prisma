model Risk {
  id                   String           @id @default(cuid())
  code                 String           @unique
  title                String
  description          String
  electionId           String
  electoralZoneId      String?
  pollingPlaceId       String?
  categoryId           String
  ownerId              String?
  ownerName            String
  responsibleId        String?
  responsibleName      String
  probability          RiskProbability  @default(MEDIUM)
  impact               RiskImpact       @default(MEDIUM)
  /**
   * Derivado: valorDaProbabilidade × valorDoImpacto (1 a 25).
   */
  score                Int              @default(9)
  /**
   * Derivado do score pelas faixas publicadas na especificação.
   */
  level                RiskLevel        @default(MODERATE)
  status               RiskStatus       @default(IDENTIFIED)
  identifiedAt         DateTime         @default(now())
  dueDate              DateTime?
  acceptedAt           DateTime?
  closedAt             DateTime?
  materializedAt       DateTime?
  actualImpact         String?
  materializationNotes String?
  /**
   * Incidente real associado, referenciado por ID opaco.
   */
  incidentId           String?
  observations         String?
  mitigationCount      Int              @default(0)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  election             Election         @relation(fields: [electionId], references: [id], onDelete: Cascade)
  electoralZone        ElectoralZone?   @relation(fields: [electoralZoneId], references: [id], onDelete: SetNull)
  pollingPlace         PollingPlace?    @relation(fields: [pollingPlaceId], references: [id], onDelete: SetNull)
  category             RiskCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  mitigations          RiskMitigation[]
  events               RiskEvent[]

  @@index([electionId, status])
  @@index([level, status])
  @@index([electoralZoneId, status])
  @@index([pollingPlaceId, status])
  @@index([categoryId])
  @@index([probability, impact])
  @@index([dueDate])
}

