model ShiftHandoverTask {
  handoverId String
  taskId     String
  createdAt  DateTime      @default(now())
  handover   ShiftHandover @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  task       Task          @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@id([handoverId, taskId])
  @@index([taskId])
}

model ShiftHandoverAsset {
  handoverId String
  assetId    String
  createdAt  DateTime      @default(now())
  handover   ShiftHandover @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  asset      Asset         @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([handoverId, assetId])
  @@index([assetId])
}

model ShiftHandoverHistory {
  id          String                     @id @default(cuid())
  handoverId  String
  actorId     String?
  action      ShiftHandoverHistoryAction
  description String
  metadata    Json?
  createdAt   DateTime                   @default(now())
  handover    ShiftHandover              @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  actor       User?                      @relation("ShiftHandoverHistoryActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([handoverId, createdAt])
  @@index([actorId, createdAt])
}

model FieldShiftSpecialtyRequirement {
