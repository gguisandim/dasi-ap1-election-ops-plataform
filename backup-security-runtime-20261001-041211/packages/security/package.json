{
  "name": "@eops/security",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "dependencies": {
    "@nestjs/common": "12.1.2"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./decorators": {
      "types": "./src/decorators.ts",
      "require": "./dist/decorators.js",
      "default": "./dist/decorators.js"
    },
    "./permissions": {
      "types": "./src/permissions.ts",
      "require": "./dist/permissions.js",
      "default": "./dist/permissions.js"
    },
    "./types": {
      "types": "./src/types.ts",
      "require": "./dist/types.js",
      "default": "./dist/types.js"
    }
  },
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json"
  }
}
