generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ElectionStatus {
  PLANNING
  PREPARATION
  IN_PROGRESS
  FINISHED
  ARCHIVED
}

enum ElectionType {
  GENERAL
  MUNICIPAL
  SUPPLEMENTARY
  REFERENDUM
}

enum RoundStatus {
  SCHEDULED
  IN_PROGRESS
  FINISHED
  CANCELLED
}

enum ResourceStatus {
  ACTIVE
  INACTIVE
}

enum MonitoringStatus {
  NORMAL
  ATTENTION
  CRITICAL
  OFFLINE
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  NEW
  TRIAGED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
  CANCELLED
}

enum IncidentEventType {
  INCIDENT_CREATED
  STATUS_CHANGED
  ASSIGNED
  COMMENT_ADDED
  SEVERITY_CHANGED
  RESOLVED
  REOPENED
  CLOSED
}

enum AssetStatus {
  AVAILABLE
  ALLOCATED
  IN_TRANSIT
  IN_USE
  MAINTENANCE
  LOST
  RETIRED
}

enum AssetCondition {
  GOOD
  ATTENTION
  DAMAGED
  UNAVAILABLE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  ASSIGN
  STATUS_CHANGE
  LOGIN
  LOGOUT
}

enum NotificationType {
  INFO
  WARNING
  CRITICAL
  SUCCESS
}

enum SimulationStatus {
  DRAFT
  RUNNING
  PAUSED
  FINISHED
  CANCELLED
}

enum FailureProbability {
  LOW
  MEDIUM
  HIGH
}

enum RouteStatus {
  PLANNED
  READY
  IN_PROGRESS
  DELAYED
  COMPLETED
  CANCELLED
}

enum RouteStopStatus {
  PENDING
  ARRIVED
  COMPLETED
  SKIPPED
}

enum VehicleStatus {
  AVAILABLE
  ASSIGNED
  IN_TRANSIT
  MAINTENANCE
  UNAVAILABLE
}

enum DeliveryStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED
}

enum LogisticsEventType {
  ROUTE_CREATED
  ROUTE_STARTED
  ROUTE_ARRIVED
  DELIVERY_COMPLETED
  DELIVERY_FAILED
  DELAY_DETECTED
  ROUTE_CANCELLED
  ITEMS_COLLECTED
  NOTE_ADDED
}

enum TransmissionStatus {
  WAITING
  QUEUED
  TRANSMITTING
  SUCCESS
  FAILED
  RETRYING
  OFFLINE
}

enum ConnectivityStatus {
  ONLINE
  DEGRADED
  OFFLINE
  UNKNOWN
}

enum TransmissionAttemptResult {
  SUCCESS
  FAILED
  TIMEOUT
  CANCELLED
}

enum TransmissionEventType {
  QUEUED
  STARTED
  FAILED
  RETRY
  SUCCESS
  CONNECTIVITY_CHANGED
  ALERT_CREATED
  NOTE_ADDED
}

enum TransmissionAlertType {
  REPEATED_FAILURE
  POINT_OFFLINE
  TRANSMISSION_DELAYED
  TOO_MANY_ATTEMPTS
  DEADLINE_NEAR
}

enum TransmissionAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum FieldTeamStatus {
  ACTIVE
  STANDBY
  INACTIVE
}

enum MemberAvailability {
  AVAILABLE
  ASSIGNED
  ON_DUTY
  UNAVAILABLE
  OFF_DUTY
}

enum FieldAllocationStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum FieldCheckType {
  CHECK_IN
  CHECK_OUT
}

enum CommunicationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum CommunicationStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  EXPIRED
  ARCHIVED
  CANCELLED
}

enum CommunicationAudienceType {
  ALL
  ELECTORAL_ZONE
  POLLING_PLACE
  FIELD_TEAM
  OPERATIONAL_ROLE
  USER
}

enum CommunicationDeliveryStatus {
  PENDING
  DELIVERED
  VIEWED
  CONFIRMED
}

enum CommunicationEventType {
  CREATED
  UPDATED
  SCHEDULED
  PUBLISHED
  DISPATCHED
  RECIPIENTS_SYNCED
  VIEWED
  CONFIRMED
  EXPIRED
  ARCHIVED
  CANCELLED
}

enum EvidenceType {
  PHOTO
  DOCUMENT
  RECEIPT
  REPORT
  LOG
  SCREENSHOT
  OTHER
}

enum EvidenceStatus {
  ACTIVE
  ARCHIVED
}

enum EvidenceLinkType {
  INCIDENT
  ASSET
  POLLING_PLACE
  ELECTORAL_ZONE
  ROUTE
  DELIVERY
  TRANSMISSION
  RISK
  COMMUNICATION
  FIELD_TEAM
  OTHER
}

enum RiskProbability {
  VERY_LOW
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

enum RiskImpact {
  VERY_LOW
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

enum RiskLevel {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

enum RiskStatus {
  IDENTIFIED
  ASSESSED
  MITIGATING
  MONITORING
  ACCEPTED
  CLOSED
  MATERIALIZED
}

enum RiskMitigationStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RiskEventType {
  CREATED
  ASSESSED
  SCORE_CHANGED
  OWNER_CHANGED
  STATUS_CHANGED
  MITIGATION_ADDED
  MITIGATION_UPDATED
  MITIGATION_COMPLETED
  MATERIALIZED
  CLOSED
  REOPENED
  NOTE_ADDED
}

enum KnowledgeArticleKind {
  ARTICLE
  RUNBOOK
}

enum KnowledgeArticleStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum RunbookUsageOutcome {
  RESOLVED
  PARTIALLY_RESOLVED
  NOT_RESOLVED
}

enum EvidenceEventType {
  CREATED
  UPLOADED
  VERSION_ADDED
  METADATA_UPDATED
  LINK_ADDED
  LINK_REMOVED
  ARCHIVED
  RESTORED
  DOWNLOADED
}

model Election {
  id                 String              @id @default(cuid())
  name               String
  description        String?
  year               Int
  type               ElectionType
  status             ElectionStatus      @default(PLANNING)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  rounds             ElectionRound[]
  zones              ElectoralZone[]
  incidents          Incident[]
  simulations        Simulation[]
  distributionRoutes DistributionRoute[]
  transmissionPoints TransmissionPoint[]
  fieldTeams         FieldTeam[]
  fieldAllocations   FieldAllocation[]
  communications     Communication[]
  evidences          Evidence[]
  risks              Risk[]

  @@index([year, status])
}

model ElectionRound {
  id          String      @id @default(cuid())
  electionId  String
  roundNumber Int
  date        DateTime
  status      RoundStatus @default(SCHEDULED)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  election    Election    @relation(fields: [electionId], references: [id], onDelete: Cascade)

  @@unique([electionId, roundNumber])
  @@index([date, status])
}

model ElectoralZone {
  id                     String                  @id @default(cuid())
  electionId             String
  number                 Int
  name                   String
  municipality           String
  state                  String                  @db.Char(2)
  status                 ResourceStatus          @default(ACTIVE)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  election               Election                @relation(fields: [electionId], references: [id], onDelete: Cascade)
  pollingPlaces          PollingPlace[]
  incidents              Incident[]
  assets                 Asset[]
  assetMovementsFrom     AssetMovement[]         @relation("AssetMovementFromZone")
  assetMovementsTo       AssetMovement[]         @relation("AssetMovementToZone")
  assetAssignments       AssetAssignment[]
  distributionRoutes     DistributionRoute[]
  transmissionPoints     TransmissionPoint[]
  fieldShifts            FieldShift[]
  fieldAllocations       FieldAllocation[]
  fieldChecks            FieldCheckEvent[]
  communicationAudiences CommunicationAudience[]
  risks                  Risk[]

  @@unique([electionId, number])
  @@index([municipality, state])
}

model PollingPlace {
  id                     String                  @id @default(cuid())
  electoralZoneId        String
  name                   String
  address                String
  district               String
  city                   String
  state                  String                  @db.Char(2)
  latitude               Decimal?                @db.Decimal(9, 6)
  longitude              Decimal?                @db.Decimal(9, 6)
  status                 ResourceStatus          @default(ACTIVE)
  monitoringStatus       MonitoringStatus        @default(NORMAL)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  electoralZone          ElectoralZone           @relation(fields: [electoralZoneId], references: [id], onDelete: Cascade)
  sections               PollingSection[]
  incidents              Incident[]
  assets                 Asset[]
  assetMovementsFrom     AssetMovement[]         @relation("AssetMovementFromPlace")
  assetMovementsTo       AssetMovement[]         @relation("AssetMovementToPlace")
  assetAssignments       AssetAssignment[]
  simulationEvents       SimulationEvent[]
  routeStops             RouteStop[]
  deliveries             Delivery[]
  transmissionPoints     TransmissionPoint[]
  fieldShifts            FieldShift[]
  fieldAllocations       FieldAllocation[]
  fieldChecks            FieldCheckEvent[]
  communicationAudiences CommunicationAudience[]
  risks                  Risk[]

  @@index([city, state])
  @@index([electoralZoneId, monitoringStatus])
}

model PollingSection {
  id               String         @id @default(cuid())
  pollingPlaceId   String
  number           Int
  registeredVoters Int
  status           ResourceStatus @default(ACTIVE)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  pollingPlace     PollingPlace   @relation(fields: [pollingPlaceId], references: [id], onDelete: Cascade)

  @@unique([pollingPlaceId, number])
  @@index([status])
}

model IncidentCategory {
  id          String     @id @default(cuid())
  key         String     @unique
  name        String
  description String?
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  incidents   Incident[]

  @@index([active, name])
}

model Incident {
  id               String               @id @default(cuid())
  code             String               @unique
  title            String
  description      String
  severity         IncidentSeverity
  status           IncidentStatus       @default(NEW)
  electionId       String
  electoralZoneId  String?
  pollingPlaceId   String?
  categoryId       String
  createdById      String?
  assignedToId     String?
  assignedToName   String?
  openedAt         DateTime             @default(now())
  resolvedAt       DateTime?
  closedAt         DateTime?
  slaDeadline      DateTime?
  isSimulated      Boolean              @default(false)
  simulationId     String?
  assetId          String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  election         Election             @relation(fields: [electionId], references: [id], onDelete: Cascade)
  electoralZone    ElectoralZone?       @relation(fields: [electoralZoneId], references: [id], onDelete: SetNull)
  pollingPlace     PollingPlace?        @relation(fields: [pollingPlaceId], references: [id], onDelete: SetNull)
  category         IncidentCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  asset            Asset?               @relation(fields: [assetId], references: [id], onDelete: SetNull)
  simulation       Simulation?          @relation(fields: [simulationId], references: [id], onDelete: SetNull)
  events           IncidentEvent[]
  assignments      IncidentAssignment[]
  simulationEvents SimulationEvent[]

  @@index([electionId, status])
  @@index([electoralZoneId, status])
  @@index([pollingPlaceId, status])
  @@index([severity, status])
  @@index([slaDeadline])
  @@index([assetId])
  @@index([simulationId])
}

model IncidentEvent {
  id         String            @id @default(cuid())
  incidentId String
  type       IncidentEventType
  message    String
  actorId    String?
  metadata   Json?
  createdAt  DateTime          @default(now())
  incident   Incident          @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
}

model IncidentAssignment {
  id             String    @id @default(cuid())
  incidentId     String
  assignedToId   String?
  assignedToName String
  assignedById   String?
  reason         String?
  assignedAt     DateTime  @default(now())
  endedAt        DateTime?
  incident       Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, assignedAt])
  @@index([assignedToId])
}

model AssetType {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  assets      Asset[]

  @@index([active, name])
}

model Asset {
  id               String            @id @default(cuid())
  assetTag         String            @unique
  name             String
  typeId           String
  serialNumber     String?
  manufacturer     String?
  model            String?
  status           AssetStatus       @default(AVAILABLE)
  condition        AssetCondition    @default(GOOD)
  electoralZoneId  String?
  pollingPlaceId   String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  type             AssetType         @relation(fields: [typeId], references: [id], onDelete: Restrict)
  electoralZone    ElectoralZone?    @relation(fields: [electoralZoneId], references: [id], onDelete: SetNull)
  pollingPlace     PollingPlace?     @relation(fields: [pollingPlaceId], references: [id], onDelete: SetNull)
  movements        AssetMovement[]
  assignments      AssetAssignment[]
  incidents        Incident[]
  simulationEvents SimulationEvent[]
  deliveryItems    DeliveryItem[]

  @@index([typeId, status])
  @@index([electoralZoneId, status])
  @@index([pollingPlaceId, status])
  @@index([condition])
}

model AssetMovement {
  id                 String         @id @default(cuid())
  assetId            String
  fromZoneId         String?
  fromPollingPlaceId String?
  toZoneId           String?
  toPollingPlaceId   String?
  originLabel        String
  destinationLabel   String
  responsibleId      String?
  responsibleName    String
  reason             String
  statusBefore       AssetStatus
  statusAfter        AssetStatus
  movedAt            DateTime       @default(now())
  createdAt          DateTime       @default(now())
  asset              Asset          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fromZone           ElectoralZone? @relation("AssetMovementFromZone", fields: [fromZoneId], references: [id], onDelete: SetNull)
  fromPollingPlace   PollingPlace?  @relation("AssetMovementFromPlace", fields: [fromPollingPlaceId], references: [id], onDelete: SetNull)
  toZone             ElectoralZone? @relation("AssetMovementToZone", fields: [toZoneId], references: [id], onDelete: SetNull)
  toPollingPlace     PollingPlace?  @relation("AssetMovementToPlace", fields: [toPollingPlaceId], references: [id], onDelete: SetNull)

  @@index([assetId, movedAt])
  @@index([toZoneId, movedAt])
  @@index([toPollingPlaceId, movedAt])
}

model AssetAssignment {
  id              String         @id @default(cuid())
  assetId         String
  electoralZoneId String?
  pollingPlaceId  String?
  assignedToId    String?
  assignedToName  String?
  assignedAt      DateTime       @default(now())
  endedAt         DateTime?
  asset           Asset          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  electoralZone   ElectoralZone? @relation(fields: [electoralZoneId], references: [id], onDelete: SetNull)
  pollingPlace    PollingPlace?  @relation(fields: [pollingPlaceId], references: [id], onDelete: SetNull)

  @@index([assetId, assignedAt])
  @@index([pollingPlaceId, endedAt])
}

model User {
  id                      String                   @id @default(cuid())
  name                    String
  email                   String                   @unique
  passwordHash            String
  status                  UserStatus               @default(ACTIVE)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  roles                   UserRole[]
  auditEvents             AuditEvent[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  communicationAudiences  CommunicationAudience[]  @relation("CommunicationAudienceTarget")
  communicationRecipients CommunicationRecipient[] @relation("CommunicationRecipientUser")

  @@index([status, name])
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String?
  system      Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model AuditEvent {
  id         String      @id @default(cuid())
  actorId    String?
  action     AuditAction
  entityType String
  entityId   String?
  oldData    Json?
  newData    Json?
  metadata   Json?
  createdAt  DateTime    @default(now())
  actor      User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  type       NotificationType @default(INFO)
  title      String
  message    String
  eventName  String?
  entityType String?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime         @default(now())
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([eventName, createdAt])
}

model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String
  eventName String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventName])
}

model SimulationScenario {
  id            String       @id @default(cuid())
  name          String
  description   String?
  configuration Json
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  simulations   Simulation[]

  @@index([active, name])
}

model Simulation {
  id                String              @id @default(cuid())
  name              String
  electionId        String
  scenarioId        String?
  status            SimulationStatus    @default(DRAFT)
  speed             Int                 @default(1)
  probability       FailureProbability  @default(LOW)
  connectivity      Boolean             @default(true)
  equipment         Boolean             @default(true)
  transmission      Boolean             @default(true)
  logistics         Boolean             @default(true)
  applyToOperations Boolean             @default(false)
  elapsedSeconds    Int                 @default(0)
  startedAt         DateTime?
  pausedAt          DateTime?
  endedAt           DateTime?
  createdById       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  election          Election            @relation(fields: [electionId], references: [id], onDelete: Cascade)
  scenario          SimulationScenario? @relation(fields: [scenarioId], references: [id], onDelete: SetNull)
  events            SimulationEvent[]
  incidents         Incident[]

  @@index([electionId, status])
  @@index([createdAt])
}

model SimulationEvent {
  id             String        @id @default(cuid())
  simulationId   String
  eventType      String
  title          String
  description    String?
  offsetSeconds  Int
  payload        Json?
  incidentId     String?
  assetId        String?
  pollingPlaceId String?
  createdAt      DateTime      @default(now())
  simulation     Simulation    @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  incident       Incident?     @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  asset          Asset?        @relation(fields: [assetId], references: [id], onDelete: SetNull)
  pollingPlace   PollingPlace? @relation(fields: [pollingPlaceId], references: [id], onDelete: SetNull)

  @@index([simulationId, offsetSeconds])
  @@index([incidentId])
}

model Vehicle {
  id              String              @id @default(cuid())
  identification  String              @unique
  plate           String              @unique
  model           String
  capacity        Int?
  status          VehicleStatus       @default(AVAILABLE)
  driverName      String?
  responsibleName String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  routes          DistributionRoute[]

  @@index([status])
}

model DistributionRoute {
  id                   String              @id @default(cuid())
  code                 String              @unique
  name                 String
  electionId           String
  electoralZoneId      String
  description          String?
  originName           String
  originLatitude       Decimal?            @db.Decimal(9, 6)
  originLongitude      Decimal?            @db.Decimal(9, 6)
  destinationName      String
  destinationLatitude  Decimal?            @db.Decimal(9, 6)
  destinationLongitude Decimal?            @db.Decimal(9, 6)
  plannedDeparture     DateTime
  plannedArrival       DateTime
  actualDeparture      DateTime?
  actualArrival        DateTime?
  responsibleName      String
  driverName           String?
  vehicleId            String?
  notes                String?
  status               RouteStatus         @default(PLANNED)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  election             Election            @relation(fields: [electionId], references: [id], onDelete: Cascade)
  electoralZone        ElectoralZone       @relation(fields: [electoralZoneId], references: [id], onDelete: Restrict)
  vehicle              Vehicle?            @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  stops                RouteStop[]
  deliveries           Delivery[]
  batches              DeliveryBatch[]
  history              RouteHistoryEvent[]

  @@index([electionId, status])
  @@index([electoralZoneId, status])
  @@index([responsibleName])
  @@index([plannedDeparture])
}

model RouteStop {
  id             String            @id @default(cuid())
  routeId        String
  pollingPlaceId String?
  order          Int
  description    String
  latitude       Decimal?          @db.Decimal(9, 6)
  longitude      Decimal?          @db.Decimal(9, 6)
  eta            DateTime
  actualAt       DateTime?
  status         RouteStopStatus   @default(PENDING)
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  route          DistributionRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  pollingPlace   PollingPlace?     @relation(fields: [pollingPlaceId], references: [id], onDelete: SetNull)

  @@unique([routeId, order])
  @@index([eta, status])
}

model DeliveryBatch {
  id          String            @id @default(cuid())
  routeId     String
  code        String            @unique
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  route       DistributionRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  deliveries  Delivery[]

  @@index([routeId])
}

model Delivery {
  id             String            @id @default(cuid())
  routeId        String
  batchId        String?
  pollingPlaceId String
  status         DeliveryStatus    @default(PENDING)
  receiverName   String?
  deliveredAt    DateTime?
  notes          String?
  proofUrl       String?
  failureReason  String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  route          DistributionRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  batch          DeliveryBatch?    @relation(fields: [batchId], references: [id], onDelete: SetNull)
  pollingPlace   PollingPlace      @relation(fields: [pollingPlaceId], references: [id], onDelete: Restrict)
  items          DeliveryItem[]

  @@index([routeId, status])
  @@index([pollingPlaceId, status])
  @@index([batchId])
}

model DeliveryItem {
  id          String   @id @default(cuid())
  deliveryId  String
  assetId     String?
  description String
  quantity    Int      @default(1)
  lotCode     String?
  delivery    Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  asset       Asset?   @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([deliveryId])
  @@index([assetId])
}

model RouteHistoryEvent {
  id        String             @id @default(cuid())
  routeId   String
  type      LogisticsEventType
  message   String
  actorId   String?
  metadata  Json?
  createdAt DateTime           @default(now())
  route     DistributionRoute  @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([routeId, createdAt])
}

model TransmissionPoint {
  id                  String                      @id @default(cuid())
  electionId          String
  electoralZoneId     String
  pollingPlaceId      String
  identification      String                      @unique
  status              TransmissionStatus          @default(WAITING)
  connectivity        ConnectivityStatus          @default(UNKNOWN)
  lastActivity        DateTime?
  observations        String?
  latencyMs           Int?
  lastCheckedAt       DateTime?
  connectionMethod    String?
  priority            Int                         @default(3)
  queuedAt            DateTime?
  operationalDeadline DateTime?
  attemptCount        Int                         @default(0)
  lastError           String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  election            Election                    @relation(fields: [electionId], references: [id], onDelete: Cascade)
  electoralZone       ElectoralZone               @relation(fields: [electoralZoneId], references: [id], onDelete: Restrict)
  pollingPlace        PollingPlace                @relation(fields: [pollingPlaceId], references: [id], onDelete: Restrict)
  attempts            TransmissionAttempt[]
  timeline            TransmissionTimelineEvent[]
  alerts              TransmissionAlert[]

  @@index([electionId, status])
  @@index([electoralZoneId, status])
  @@index([pollingPlaceId])
  @@index([priority, queuedAt])
  @@index([connectivity])
}

model TransmissionAttempt {
  id         String                    @id @default(cuid())
  pointId    String
  number     Int
  startedAt  DateTime
  endedAt    DateTime
  result     TransmissionAttemptResult
  durationMs Int
  error      String?
  createdAt  DateTime                  @default(now())
  point      TransmissionPoint         @relation(fields: [pointId], references: [id], onDelete: Cascade)

  @@unique([pointId, number])
  @@index([pointId, startedAt])
}

model TransmissionTimelineEvent {
  id        String                @id @default(cuid())
  pointId   String
  type      TransmissionEventType
  message   String
  metadata  Json?
  createdAt DateTime              @default(now())
  point     TransmissionPoint     @relation(fields: [pointId], references: [id], onDelete: Cascade)

  @@index([pointId, createdAt])
}

model TransmissionAlert {
  id         String                  @id @default(cuid())
  pointId    String
  type       TransmissionAlertType
  status     TransmissionAlertStatus @default(OPEN)
  message    String
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  resolvedAt DateTime?
  point      TransmissionPoint       @relation(fields: [pointId], references: [id], onDelete: Cascade)

  @@index([pointId, status])
  @@index([type, status])
}

model FieldTeam {
  id                     String                  @id @default(cuid())
  name                   String
  code                   String                  @unique
  electionId             String
  responsibleName        String
  status                 FieldTeamStatus         @default(ACTIVE)
  notes                  String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  election               Election                @relation(fields: [electionId], references: [id], onDelete: Cascade)
  members                FieldMember[]
  shifts                 FieldShift[]
  allocations            FieldAllocation[]
  communicationAudiences CommunicationAudience[]

  @@index([electionId, status])
  @@index([responsibleName])
}

model FieldRole {
  id                     String                  @id @default(cuid())
  key                    String                  @unique
  name                   String
  description            String?
  active                 Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  members                FieldMember[]
  communicationAudiences CommunicationAudience[]

  @@index([active, name])
}

model FieldSpecialty {
  id          String                 @id @default(cuid())
  key         String                 @unique
  name        String
  description String?
  active      Boolean                @default(true)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  members     FieldMemberSpecialty[]

  @@index([active, name])
}

model FieldMember {
  id                      String                   @id @default(cuid())
  teamId                  String
  roleId                  String
  name                    String
  phone                   String?
  email                   String?
  status                  MemberAvailability       @default(AVAILABLE)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  team                    FieldTeam                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  role                    FieldRole                @relation(fields: [roleId], references: [id], onDelete: Restrict)
  specialties             FieldMemberSpecialty[]
  shifts                  FieldShift[]
  allocations             FieldAllocation[]
  checks                  FieldCheckEvent[]
  communicationRecipients CommunicationRecipient[]

  @@index([teamId, status])
  @@index([roleId])
  @@index([name])
}

model FieldMemberSpecialty {
  id          String         @id @default(cuid())
  memberId    String
  specialtyId String
  member      FieldMember    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  specialty   FieldSpecialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@unique([memberId, specialtyId])
  @@index([specialtyId])
}

model FieldShift {
  id              String         @id @default(cuid())
  teamId          String
  memberId        String?
  electoralZoneId String?
  pollingPlaceId  String?
  startsAt        DateTime
  endsAt          DateTime
  notes           String?
  createdAt       DateTime       @default(now())
  team            FieldTeam      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  member          FieldMember?   @relation(fields: [memberId], references: [id], onDelete: SetNull)
  electoralZone   ElectoralZone? @relation(fields: [electoralZoneId], references: [id], onDelete: SetNull)
  pollingPlace    PollingPlace?  @relation(fields: [pollingPlaceId], references: [id], onDelete: SetNull)

  @@index([startsAt, endsAt])
  @@index([teamId, startsAt])
  @@index([memberId, startsAt])
}

model FieldAllocation {
  id              String                @id @default(cuid())
  electionId      String
  teamId          String?
  memberId        String?
  electoralZoneId String?
  pollingPlaceId  String?
  routeId         String?
  activity        String?
  startsAt        DateTime
  endsAt          DateTime?
  status          FieldAllocationStatus @default(SCHEDULED)
  notes           String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  election        Election              @relation(fields: [electionId], references: [id], onDelete: Cascade)
  team            FieldTeam?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  member          FieldMember?          @relation(fields: [memberId], references: [id], onDelete: SetNull)
  electoralZone   ElectoralZone?        @relation(fields: [electoralZoneId], references: [id], onDelete: SetNull)
  pollingPlace    PollingPlace?         @relation(fields: [pollingPlaceId], references: [id], onDelete: SetNull)

  @@index([electionId, status])
  @@index([electoralZoneId, status])
  @@index([pollingPlaceId, status])
  @@index([routeId])
}

model FieldCheckEvent {
  id              String         @id @default(cuid())
  memberId        String
  electoralZoneId String?
  pollingPlaceId  String?
  type            FieldCheckType
  occurredAt      DateTime       @default(now())
  notes           String?
  createdAt       DateTime       @default(now())
  member          FieldMember    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  electoralZone   ElectoralZone? @relation(fields: [electoralZoneId], references: [id], onDelete: SetNull)
  pollingPlace    PollingPlace?  @relation(fields: [pollingPlaceId], references: [id], onDelete: SetNull)

  @@index([memberId, occurredAt])
  @@index([pollingPlaceId, occurredAt])
}

model CommunicationCategory {
  id             String                  @id @default(cuid())
  key            String                  @unique
  name           String
  description    String?
  color          String?
  active         Boolean                 @default(true)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  communications Communication[]
  templates      CommunicationTemplate[]

  @@index([active, name])
}

model CommunicationTag {
  id        String                 @id @default(cuid())
  label     String                 @unique
  slug      String                 @unique
  createdAt DateTime               @default(now())
  links     CommunicationTagLink[]

  @@index([label])
}

model CommunicationTagLink {
  id              String           @id @default(cuid())
  communicationId String
  tagId           String
  communication   Communication    @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  tag             CommunicationTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([communicationId, tagId])
  @@index([tagId])
}

model CommunicationTemplate {
  id           String                 @id @default(cuid())
  name         String                 @unique
  description  String?
  defaultTitle String
  body         String
  priority     CommunicationPriority  @default(NORMAL)
  categoryId   String?
  active       Boolean                @default(true)
  createdById  String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  category     CommunicationCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([active, name])
  @@index([categoryId])
}

model Communication {
  id             String                   @id @default(cuid())
  code           String                   @unique
  title          String
  content        String
  priority       CommunicationPriority    @default(NORMAL)
  status         CommunicationStatus      @default(DRAFT)
  electionId     String
  categoryId     String?
  authorId       String?
  authorName     String
  observations   String?
  scheduledAt    DateTime?
  publishedAt    DateTime?
  dispatchedAt   DateTime?
  expiresAt      DateTime?
  archivedAt     DateTime?
  cancelledAt    DateTime?
  recipientCount Int                      @default(0)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  election       Election                 @relation(fields: [electionId], references: [id], onDelete: Cascade)
  category       CommunicationCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags           CommunicationTagLink[]
  audiences      CommunicationAudience[]
  recipients     CommunicationRecipient[]
  timeline       CommunicationEvent[]

  @@index([electionId, status])
  @@index([status, priority])
  @@index([priority, publishedAt])
  @@index([categoryId])
  @@index([publishedAt])
  @@index([expiresAt])
}

model CommunicationAudience {
  id              String                    @id @default(cuid())
  communicationId String
  type            CommunicationAudienceType
  electoralZoneId String?
  pollingPlaceId  String?
  fieldTeamId     String?
  fieldRoleId     String?
  userId          String?
  label           String?
  createdAt       DateTime                  @default(now())
  communication   Communication             @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  electoralZone   ElectoralZone?            @relation(fields: [electoralZoneId], references: [id], onDelete: Cascade)
  pollingPlace    PollingPlace?             @relation(fields: [pollingPlaceId], references: [id], onDelete: Cascade)
  fieldTeam       FieldTeam?                @relation(fields: [fieldTeamId], references: [id], onDelete: Cascade)
  fieldRole       FieldRole?                @relation(fields: [fieldRoleId], references: [id], onDelete: Cascade)
  user            User?                     @relation("CommunicationAudienceTarget", fields: [userId], references: [id], onDelete: Cascade)
  recipients      CommunicationRecipient[]

  @@index([communicationId, type])
  @@index([electoralZoneId])
  @@index([pollingPlaceId])
  @@index([fieldTeamId])
  @@index([fieldRoleId])
  @@index([userId])
}

model CommunicationRecipient {
  id               String                      @id @default(cuid())
  communicationId  String
  audienceId       String?
  userId           String?
  memberId         String?
  name             String
  email            String?
  roleLabel        String?
  sourceLabel      String?
  deliveryStatus   CommunicationDeliveryStatus @default(PENDING)
  deliveredAt      DateTime?
  viewedAt         DateTime?
  confirmedAt      DateTime?
  confirmationNote String?
  dedupeKey        String
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  communication    Communication               @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  audience         CommunicationAudience?      @relation(fields: [audienceId], references: [id], onDelete: Cascade)
  user             User?                       @relation("CommunicationRecipientUser", fields: [userId], references: [id], onDelete: SetNull)
  member           FieldMember?                @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@unique([communicationId, dedupeKey])
  @@index([communicationId, deliveryStatus])
  @@index([userId, deliveryStatus])
  @@index([memberId])
  @@index([audienceId])
}

model CommunicationEvent {
  id              String                 @id @default(cuid())
  communicationId String
  type            CommunicationEventType
  message         String
  actorId         String?
  actorName       String?
  metadata        Json?
  createdAt       DateTime               @default(now())
  communication   Communication          @relation(fields: [communicationId], references: [id], onDelete: Cascade)

  @@index([communicationId, createdAt])
  @@index([type, createdAt])
}

model EvidenceTag {
  id        String            @id @default(cuid())
  label     String            @unique
  slug      String            @unique
  createdAt DateTime          @default(now())
  links     EvidenceTagLink[]

  @@index([label])
}

model EvidenceTagLink {
  id         String      @id @default(cuid())
  evidenceId String
  tagId      String
  evidence   Evidence    @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  tag        EvidenceTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([evidenceId, tagId])
  @@index([tagId])
}

model Evidence {
  id             String            @id @default(cuid())
  code           String            @unique
  title          String
  description    String?
  type           EvidenceType
  status         EvidenceStatus    @default(ACTIVE)
  electionId     String?
  authorId       String?
  authorName     String
  origin         String?
  observations   String?
  capturedAt     DateTime?
  currentVersion Int               @default(0)
  versionCount   Int               @default(0)
  archivedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  election       Election?         @relation(fields: [electionId], references: [id], onDelete: SetNull)
  tags           EvidenceTagLink[]
  versions       EvidenceVersion[]
  links          EvidenceLink[]
  timeline       EvidenceEvent[]

  @@index([type, status])
  @@index([electionId, status])
  @@index([authorId])
  @@index([createdAt])
  @@index([capturedAt])
}

model EvidenceVersion {
  id            String   @id @default(cuid())
  evidenceId    String
  number        Int
  fileName      String
  extension     String
  mimeType      String
  size          Int
  checksum      String
  storageKey    String
  storageDriver String
  reason        String?
  description   String?
  authorId      String?
  authorName    String
  isCurrent     Boolean  @default(false)
  createdAt     DateTime @default(now())
  evidence      Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([evidenceId, number])
  @@index([evidenceId, createdAt])
  @@index([checksum])
  @@index([isCurrent])
}

model EvidenceLink {
  id          String           @id @default(cuid())
  evidenceId  String
  type        EvidenceLinkType
  targetId    String
  targetLabel String?
  notes       String?
  createdAt   DateTime         @default(now())
  evidence    Evidence         @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([evidenceId, type, targetId])
  @@index([type, targetId])
  @@index([evidenceId])
}

model EvidenceEvent {
  id         String            @id @default(cuid())
  evidenceId String
  type       EvidenceEventType
  message    String
  actorId    String?
  actorName  String?
  metadata   Json?
  createdAt  DateTime          @default(now())
  evidence   Evidence          @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@index([evidenceId, createdAt])
  @@index([type, createdAt])
}

model KnowledgeCategory {
  id          String             @id @default(cuid())
  key         String             @unique
  name        String
  description String?
  color       String?
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  articles    KnowledgeArticle[]

  @@index([active, name])
}

model KnowledgeTag {
  id        String             @id @default(cuid())
  label     String             @unique
  slug      String             @unique
  createdAt DateTime           @default(now())
  links     KnowledgeTagLink[]

  @@index([label])
}

model KnowledgeTagLink {
  id        String           @id @default(cuid())
  articleId String
  tagId     String
  article   KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       KnowledgeTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([articleId, tagId])
  @@index([tagId])
}

model KnowledgeArticle {
  id                  String                    @id @default(cuid())
  code                String                    @unique
  kind                KnowledgeArticleKind      @default(ARTICLE)
  title               String
  summary             String
  content             String?
  status              KnowledgeArticleStatus    @default(DRAFT)
  categoryId          String?
  authorId            String?
  authorName          String
  currentVersion      Int                       @default(1)
  versionCount        Int                       @default(1)
  views               Int                       @default(0)
  usageCount          Int                       @default(0)
  resolvedCount       Int                       @default(0)
  // Associação para recomendação determinística a partir de um incidente.
  incidentCategoryKey String?
  incidentSeverity    IncidentSeverity?
  assetTypeKey        String?
  keywords            String[]                  @default([])
  // Campos exclusivos de runbook.
  problem             String?
  symptoms            String?
  diagnosis           String?
  prerequisites       String?
  validation          String?
  rollback            String?
  escalation          String?
  references          String?
  publishedAt         DateTime?
  reviewedAt          DateTime?
  archivedAt          DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  category            KnowledgeCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags                KnowledgeTagLink[]
  steps               RunbookStep[]
  versions            KnowledgeArticleVersion[]
  usages              RunbookUsage[]

  @@index([kind, status])
  @@index([status, categoryId])
  @@index([incidentCategoryKey, status])
  @@index([incidentSeverity, status])
  @@index([updatedAt])
  @@index([publishedAt])
}

model RunbookStep {
  id          String           @id @default(cuid())
  articleId   String
  order       Int
  title       String
  instruction String
  expected    String?
  required    Boolean          @default(true)
  warning     String?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  article     KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, order])
  @@index([articleId])
}

model KnowledgeArticleVersion {
  id         String           @id @default(cuid())
  articleId  String
  number     Int
  title      String
  summary    String
  content    String?
  /**
   * Instantâneo dos passos no momento da versão.
   */
  steps      Json?
  note       String
  authorId   String?
  authorName String
  createdAt  DateTime         @default(now())
  article    KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, number])
  @@index([articleId, createdAt])
}

model RunbookUsage {
  id             String              @id @default(cuid())
  articleId      String
  incidentId     String?
  incidentCode   String?
  userId         String?
  userName       String
  outcome        RunbookUsageOutcome
  resolved       Boolean             @default(false)
  stepsCompleted Int?
  notes          String?
  startedAt      DateTime            @default(now())
  finishedAt     DateTime?
  createdAt      DateTime            @default(now())
  article        KnowledgeArticle    @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, createdAt])
  @@index([incidentId])
  @@index([outcome])
  @@index([userId, createdAt])
}

model RiskCategory {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  color       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  risks       Risk[]

  @@index([active, name])
}

model Risk {
  id                   String           @id @default(cuid())
  code                 String           @unique
  title                String
  description          String
  electionId           String
  electoralZoneId      String?
  pollingPlaceId       String?
  categoryId           String
  ownerId              String?
  ownerName            String
  responsibleId        String?
  responsibleName      String
  probability          RiskProbability  @default(MEDIUM)
  impact               RiskImpact       @default(MEDIUM)
  /**
   * Derivado: valorDaProbabilidade × valorDoImpacto (1 a 25).
   */
  score                Int              @default(9)
  /**
   * Derivado do score pelas faixas publicadas na especificação.
   */
  level                RiskLevel        @default(MODERATE)
  status               RiskStatus       @default(IDENTIFIED)
  identifiedAt         DateTime         @default(now())
  dueDate              DateTime?
  acceptedAt           DateTime?
  closedAt             DateTime?
  materializedAt       DateTime?
  actualImpact         String?
  materializationNotes String?
  /**
   * Incidente real associado, referenciado por ID opaco.
   */
  incidentId           String?
  observations         String?
  mitigationCount      Int              @default(0)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  election             Election         @relation(fields: [electionId], references: [id], onDelete: Cascade)
  electoralZone        ElectoralZone?   @relation(fields: [electoralZoneId], references: [id], onDelete: SetNull)
  pollingPlace         PollingPlace?    @relation(fields: [pollingPlaceId], references: [id], onDelete: SetNull)
  category             RiskCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  mitigations          RiskMitigation[]
  events               RiskEvent[]

  @@index([electionId, status])
  @@index([level, status])
  @@index([electoralZoneId, status])
  @@index([pollingPlaceId, status])
  @@index([categoryId])
  @@index([probability, impact])
  @@index([dueDate])
}

model RiskMitigation {
  id              String               @id @default(cuid())
  riskId          String
  description     String
  responsibleName String
  responsibleId   String?
  dueDate         DateTime?
  status          RiskMitigationStatus @default(PLANNED)
  /**
   * Percentual de conclusão de 0 a 100.
   */
  progress        Int                  @default(0)
  /**
   * Evidência comprobatória, referenciada por ID opaco.
   */
  evidenceId      String?
  evidenceLabel   String?
  notes           String?
  completedAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  risk            Risk                 @relation(fields: [riskId], references: [id], onDelete: Cascade)

  @@index([riskId, status])
  @@index([dueDate, status])
}

model RiskEvent {
  id        String        @id @default(cuid())
  riskId    String
  type      RiskEventType
  message   String
  actorId   String?
  actorName String?
  metadata  Json?
  createdAt DateTime      @default(now())
  risk      Risk          @relation(fields: [riskId], references: [id], onDelete: Cascade)

  @@index([riskId, createdAt])
  @@index([type, createdAt])
}
