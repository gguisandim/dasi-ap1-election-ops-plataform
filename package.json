{
  "name": "election-ops-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "npm run dev -w @eops/web",
    "dev:api": "npm run start:dev -w @eops/api",
    "build": "npm run build:api && npm run build:web",
    "build:web": "npm run build -w @eops/web",
    "build:api": "npm run build -w @eops/api",
    "typecheck": "npm run typecheck -w @eops/api && npm run typecheck -w @eops/web",
    "lint": "eslint apps packages plugins",
    "test": "vitest run",
    "db:generate": "prisma generate --schema packages/database/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema packages/database/prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema packages/database/prisma/schema.prisma",
    "db:seed": "tsx packages/database/prisma/seed.ts",
    "db:validate": "prisma validate --schema packages/database/prisma/schema.prisma",
    "count:loc": "node scripts/count-loc.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.2",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "prisma": "^6.16.3",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript-eslint": "^8.44.1",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
