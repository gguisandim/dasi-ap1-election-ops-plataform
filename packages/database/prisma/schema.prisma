  id                          String                       @id @default(cuid())
  title                       String
  description                 String?                      @db.Text
  status                      TaskStatus                   @default(PENDING)
  priority                    TaskPriority                 @default(MEDIUM)
  executionMode               TaskExecutionMode            @default(OFFICE)
  requiredTeamSize            Int?
  assigneeId                  String?
  createdById                 String?
  electionId                  String
  electoralZoneId             String?
  pollingPlaceId              String?
  parentId                    String?
  milestoneId                 String?
  dueAt                       DateTime?
  completedAt                 DateTime?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  assignee                    User?                        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy                   User?                        @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  election                    Election                     @relation(fields: [electionId], references: [id], onDelete: Cascade)
  electoralZone               ElectoralZone?               @relation(fields: [electoralZoneId], references: [id], onDelete: SetNull)
  pollingPlace                PollingPlace?                @relation(fields: [pollingPlaceId], references: [id], onDelete: SetNull)
  parent                      Task?                        @relation("TaskHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  subtasks                    Task[]                       @relation("TaskHierarchy")
  milestone                   TaskMilestone?               @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  checklistItems              TaskChecklistItem[]
  labels                      TaskLabelAssignment[]
  dependencies                TaskDependency[]             @relation("TaskDependencies")
  dependents                  TaskDependency[]             @relation("TaskDependents")
  comments                    TaskComment[]
  history                     TaskHistory[]
  specialtyRequirements       TaskSpecialtyRequirement[]
  dispatches                  FieldDispatch[]
  handoverReferences          ShiftHandoverTask[]
  resourceRequests            ResourceRequest[]
  resourceRequestFulfillments ResourceRequestFulfillment[]
  postmortemActionItems       PostmortemActionItem[]

  @@index([electionId, status])
  @@index([electoralZoneId, status])
  @@index([pollingPlaceId, status])
  @@index([assigneeId, status])
  @@index([priority, dueAt])
  @@index([parentId])
  @@index([milestoneId])
}

model TaskChecklistItem {
  id        String    @id @default(cuid())
  taskId    String
  title     String
  order     Int
  done      Boolean   @default(false)
  doneAt    DateTime?
  doneById  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  doneBy    User?     @relation("TaskChecklistItemDoneBy", fields: [doneById], references: [id], onDelete: SetNull)

  @@unique([taskId, order])
  @@index([taskId, done])
}

model TaskLabel {
  id        String                @id @default(cuid())
  name      String                @unique
  createdAt DateTime              @default(now())
  tasks     TaskLabelAssignment[]
}

model TaskLabelAssignment {
  taskId    String
  labelId   String
  createdAt DateTime  @default(now())
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label     TaskLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
}

model TaskMilestone {
  id          String    @id @default(cuid())
  electionId  String
  name        String
  description String?
  dueAt       DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  election    Election  @relation(fields: [electionId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@unique([electionId, name])
  @@index([electionId])
}

model TaskSavedFilter {
  id        String   @id @default(cuid())
  userId    String
  name      String
  filters   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

model TaskDependency {
  taskId      String
  dependsOnId String
  createdAt   DateTime @default(now())
  task        Task     @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn   Task     @relation("TaskDependents", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@id([taskId, dependsOnId])
  @@index([dependsOnId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String?
  content   String   @db.Text
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
}

model TaskHistory {
  id        String            @id @default(cuid())
  taskId    String
  actorId   String?
  action    TaskHistoryAction
  message   String
  metadata  Json?
  createdAt DateTime          @default(now())
  task      Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor     User?             @relation("TaskHistoryActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@index([actorId, createdAt])
}

model TaskSpecialtyRequirement {
  id            String         @id @default(cuid())
  taskId        String
  specialtyId   String
  requiredCount Int
  task          Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  specialty     FieldSpecialty @relation(fields: [specialtyId], references: [id], onDelete: Restrict)

  @@unique([taskId, specialtyId])
  @@index([specialtyId])
}

// ---------------------------------------------------------------------------
// Operational Coordination Suite — Command Center / Resource Requests /
// Postmortem. Ver SPEC/2026-10-06-operational-coordination-suite.md.
// ---------------------------------------------------------------------------

enum CommandCenterHealth {
  NORMAL
  ATTENTION
  CRITICAL
}

enum CommandCenterLayoutMode {
  STANDARD
  WALLBOARD
}

model CommandCenterSavedView {
  id             String                  @id @default(cuid())
  ownerId        String
  name           String
  description    String?
  filters        Json
  layoutMode     CommandCenterLayoutMode @default(STANDARD)
  refreshSeconds Int                     @default(45)
  isDefault      Boolean                 @default(false)
  shared         Boolean                 @default(false)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  owner          User                    @relation("CommandCenterSavedViewOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, name])
  @@index([ownerId, isDefault])
  @@index([shared, updatedAt])
}

model CommandCenterSnapshot {
  id              String              @id @default(cuid())
  createdById     String
  name            String
  description     String?
  electionId      String?
  electoralZoneId String?
  health          CommandCenterHealth
  payload         Json
  createdAt       DateTime            @default(now())
  createdBy       User                @relation("CommandCenterSnapshotCreator", fields: [createdById], references: [id], onDelete: Cascade)
  election        Election?           @relation(fields: [electionId], references: [id], onDelete: SetNull)
  electoralZone   ElectoralZone?      @relation(fields: [electoralZoneId], references: [id], onDelete: SetNull)

  @@index([electionId, createdAt])
  @@index([createdAt])
}

enum ResourceRequestStatus {
  DRAFT
  SUBMITTED
  TRIAGED
  APPROVED
  PARTIALLY_FULFILLED
  FULFILLED
  REJECTED
  CANCELLED
}

enum ResourceRequestPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum ResourceRequestItemKind {
  ASSET
  ASSET_TYPE
  FIELD_TEAM
  VEHICLE
  TRANSPORT
  TECH_SUPPORT
  MATERIAL
  OTHER
}

enum ResourceRequestHistoryAction {
  CREATED
  UPDATED
  SUBMITTED
  TRIAGED
  OWNER_CHANGED
  PRIORITY_CHANGED
  APPROVED
  REJECTED
  FULFILLMENT_ADDED
  FULFILLMENT_REMOVED
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
  COMMENT_ADDED
}

model ResourceRequest {
  id                 String                   @id @default(cuid())
  code               String                   @unique
  electionId         String
  electoralZoneId    String?
  pollingPlaceId     String?
  incidentId         String?
  taskId             String?
  title              String
  description        String                   @db.Text
  priority           ResourceRequestPriority  @default(NORMAL)
  status             ResourceRequestStatus    @default(DRAFT)
  requestedById      String
  ownerId            String?
  neededAt           DateTime?
  submittedAt        DateTime?
  triagedAt          DateTime?
  approvedAt         DateTime?
  fulfilledAt        DateTime?
  rejectedAt         DateTime?
  cancelledAt        DateTime?
  triageNotes        String?                  @db.Text
  rejectionReason    String?                  @db.Text
  cancellationReason String?                  @db.Text
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  election           Election                 @relation(fields: [electionId], references: [id], onDelete: Cascade)
  electoralZone      ElectoralZone?           @relation(fields: [electoralZoneId], references: [id], onDelete: SetNull)
  pollingPlace       PollingPlace?            @relation(fields: [pollingPlaceId], references: [id], onDelete: SetNull)
  incident           Incident?                @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  task               Task?                    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  requestedBy        User                     @relation("ResourceRequestRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  owner              User?                    @relation("ResourceRequestOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  items              ResourceRequestItem[]
  history            ResourceRequestHistory[]
  comments           ResourceRequestComment[]

  @@index([status, priority])
  @@index([electionId, status])
  @@index([neededAt, status])
  @@index([ownerId, status])
  @@index([requestedById, status])
  @@index([incidentId])
  @@index([taskId])
  @@index([electoralZoneId, status])
}

model ResourceRequestItem {
  id           String                       @id @default(cuid())
  requestId    String
  kind         ResourceRequestItemKind
  label        String
  description  String?                      @db.Text
  quantity     Int                          @default(1)
  notes        String?                      @db.Text
  assetTypeId  String?
  fieldTeamId  String?
  vehicleId    String?
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt
  request      ResourceRequest              @relation(fields: [requestId], references: [id], onDelete: Cascade)
  assetType    AssetType?                   @relation(fields: [assetTypeId], references: [id], onDelete: SetNull)
  fieldTeam    FieldTeam?                   @relation(fields: [fieldTeamId], references: [id], onDelete: SetNull)
  vehicle      Vehicle?                     @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  fulfillments ResourceRequestFulfillment[]

  @@index([requestId, kind])
  @@index([assetTypeId])
  @@index([fieldTeamId])
  @@index([vehicleId])
}

model ResourceRequestFulfillment {
  id                 String              @id @default(cuid())
  requestItemId      String
  quantity           Int
  fulfilledById      String
  assetId            String?
  assetReservationId String?
  fieldTeamId        String?
  vehicleId          String?
  routeId            String?
  taskId             String?
  notes              String?             @db.Text
  createdAt          DateTime            @default(now())
  requestItem        ResourceRequestItem @relation(fields: [requestItemId], references: [id], onDelete: Cascade)
  fulfilledBy        User                @relation("ResourceRequestFulfiller", fields: [fulfilledById], references: [id], onDelete: Restrict)
  asset              Asset?              @relation(fields: [assetId], references: [id], onDelete: SetNull)
  assetReservation   AssetReservation?   @relation(fields: [assetReservationId], references: [id], onDelete: SetNull)
  fieldTeam          FieldTeam?          @relation(fields: [fieldTeamId], references: [id], onDelete: SetNull)
  vehicle            Vehicle?            @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  route              DistributionRoute?  @relation(fields: [routeId], references: [id], onDelete: SetNull)
  task               Task?               @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([requestItemId, createdAt])
  @@index([assetId])
  @@index([assetReservationId])
  @@index([fieldTeamId])
  @@index([vehicleId])
  @@index([routeId])
  @@index([taskId])
  @@index([fulfilledById, createdAt])
}

model ResourceRequestHistory {
  id          String                       @id @default(cuid())
  requestId   String
  actorId     String?
  action      ResourceRequestHistoryAction
  description String
  metadata    Json?
  createdAt   DateTime                     @default(now())
  request     ResourceRequest              @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor       User?                        @relation("ResourceRequestHistoryActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
  @@index([actorId, createdAt])
}

model ResourceRequestComment {
  id        String          @id @default(cuid())
  requestId String
  authorId  String
  body      String          @db.Text
  createdAt DateTime        @default(now())
  request   ResourceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author    User            @relation("ResourceRequestCommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
  @@index([authorId, createdAt])
}

enum PostmortemStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum PostmortemCauseType {
  ROOT_CAUSE
  CONTRIBUTING_FACTOR
  CONDITION
}

enum PostmortemCauseCategory {
  PEOPLE
  PROCESS
  TECHNOLOGY
  COMMUNICATION
  LOGISTICS
  EXTERNAL
  OTHER
}

enum PostmortemLessonType {
  WENT_WELL
  WENT_WRONG
  LESSON
  FOLLOW_UP
}

enum PostmortemActionStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum PostmortemReviewDecision {
  APPROVED
  CHANGES_REQUESTED
}

enum PostmortemTimelineSource {
  INCIDENT_EVENT
  SHIFT_HANDOVER
  TASK
  RESOURCE_REQUEST
  MANUAL
}

model Postmortem {
  id                   String                      @id @default(cuid())
  code                 String                      @unique
  title                String
  primaryIncidentId    String
  status               PostmortemStatus            @default(DRAFT)
  executiveSummary     String?                     @db.Text
  impactSummary        String?                     @db.Text
  detectionSummary     String?                     @db.Text
  responseSummary      String?                     @db.Text
  resolutionSummary    String?                     @db.Text
  rootCauseSummary     String?                     @db.Text
  lessonsSummary       String?                     @db.Text
  createdById          String
  ownerId              String?
  submittedForReviewAt DateTime?
  approvedAt           DateTime?
  publishedAt          DateTime?
  publishedById        String?
  archivedAt           DateTime?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  primaryIncident      Incident                    @relation("PostmortemPrimaryIncident", fields: [primaryIncidentId], references: [id], onDelete: Restrict)
  createdBy            User                        @relation("PostmortemCreator", fields: [createdById], references: [id], onDelete: Restrict)
  owner                User?                       @relation("PostmortemOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  publishedBy          User?                       @relation("PostmortemPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  relatedIncidents     PostmortemRelatedIncident[]
  timeline             PostmortemTimelineEntry[]
  causes               PostmortemCause[]
  lessons              PostmortemLesson[]
  actions              PostmortemActionItem[]
  reviewers            PostmortemReviewer[]
  reviews              PostmortemReview[]

  @@index([status, createdAt])
  @@index([primaryIncidentId])
  @@index([ownerId, status])
}

model PostmortemRelatedIncident {
  id           String     @id @default(cuid())
  postmortemId String
  incidentId   String
  note         String?    @db.Text
  createdAt    DateTime   @default(now())
  postmortem   Postmortem @relation(fields: [postmortemId], references: [id], onDelete: Cascade)
  incident     Incident   @relation(fields: [incidentId], references: [id], onDelete: Restrict)

  @@unique([postmortemId, incidentId])
  @@index([incidentId])
}

model PostmortemTimelineEntry {
  id           String                   @id @default(cuid())
  postmortemId String
  occurredAt   DateTime
  sourceType   PostmortemTimelineSource
  sourceId     String?
  title        String
  description  String?                  @db.Text
  imported     Boolean                  @default(false)
  createdById  String?
  createdAt    DateTime                 @default(now())
  postmortem   Postmortem               @relation(fields: [postmortemId], references: [id], onDelete: Cascade)
  createdBy    User?                    @relation("PostmortemTimelineActor", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([postmortemId, sourceType, sourceId])
  @@index([postmortemId, occurredAt])
}

model PostmortemCause {
  id           String                  @id @default(cuid())
  postmortemId String
  parentId     String?
  type         PostmortemCauseType
  category     PostmortemCauseCategory
  statement    String                  @db.Text
  evidence     String?                 @db.Text
  order        Int                     @default(0)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  postmortem   Postmortem              @relation(fields: [postmortemId], references: [id], onDelete: Cascade)
  parent       PostmortemCause?        @relation("PostmortemCauseTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     PostmortemCause[]       @relation("PostmortemCauseTree")

  @@index([postmortemId, type])
  @@index([parentId])
}

model PostmortemLesson {
  id           String                   @id @default(cuid())
  postmortemId String
  type         PostmortemLessonType
  title        String
  description  String                   @db.Text
  category     PostmortemCauseCategory?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  postmortem   Postmortem               @relation(fields: [postmortemId], references: [id], onDelete: Cascade)

  @@index([postmortemId, type])
}

model PostmortemActionItem {
  id                String                 @id @default(cuid())
  postmortemId      String
  title             String
  description       String?                @db.Text
  priority          TaskPriority           @default(MEDIUM)
  ownerUserId       String?
  dueAt             DateTime?
  status            PostmortemActionStatus @default(OPEN)
  taskId            String?
  createdById       String?
  overdueNotifiedAt DateTime?
  completedAt       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  postmortem        Postmortem             @relation(fields: [postmortemId], references: [id], onDelete: Cascade)
  ownerUser         User?                  @relation("PostmortemActionOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  createdBy         User?                  @relation("PostmortemActionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  task              Task?                  @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([postmortemId, status])
  @@index([status, dueAt])
  @@index([ownerUserId, status])
  @@index([taskId])
}

model PostmortemReviewer {
  id           String     @id @default(cuid())
  postmortemId String
  userId       String
  createdAt    DateTime   @default(now())
  postmortem   Postmortem @relation(fields: [postmortemId], references: [id], onDelete: Cascade)
  user         User       @relation("PostmortemReviewerAssignee", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([postmortemId, userId])
  @@index([userId])
}

model PostmortemReview {
  id           String                   @id @default(cuid())
  postmortemId String
  reviewerId   String
  decision     PostmortemReviewDecision
  comment      String?                  @db.Text
  createdAt    DateTime                 @default(now())
  postmortem   Postmortem               @relation(fields: [postmortemId], references: [id], onDelete: Cascade)
  reviewer     User                     @relation("PostmortemReviewAuthor", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([postmortemId, createdAt])
  @@index([reviewerId, createdAt])
}
