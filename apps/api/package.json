    "@eops/event-bus": "0.1.0",
    "@eops/plugin-access-control": "0.1.0",
    "@eops/plugin-audit": "0.1.0",
    "@eops/plugin-communications": "0.1.0",
    "@eops/plugin-documents-evidence": "0.1.0",
    "@eops/plugin-elections": "0.1.0",
    "@eops/plugin-electoral-zones": "0.1.0",
    "@eops/plugin-field-teams": "0.1.0",
    "@eops/plugin-incidents": "0.1.0",
    "@eops/plugin-inventory": "0.1.0",
    "@eops/plugin-knowledge-runbooks": "0.1.0",
    "@eops/plugin-notifications": "0.1.0",
    "@eops/plugin-operational-map": "0.1.0",
    "@eops/plugin-operational-simulator": "0.1.0",
    "@eops/plugin-polling-places": "0.1.0",
