{
  "name": "@eops/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start:dev": "nest build && concurrently -k -n compiler,server \"nest build --watch\" \"node --watch dist/apps/api/src/main.js\"",
    "start:prod": "node dist/apps/api/src/main.js",
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src ../../plugins/*/*/src/server ../../packages/database/src"
  },
  "dependencies": {
    "@eops/database": "0.1.0",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/mapped-types": "12.0.0",
    "@nestjs/platform-express": "12.1.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@types/express": "5.0.6",
    "@types/node": "26.6.3",
    "typescript": "6.0.3"
  }
}
